// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Get a free hosted Postgres database in seconds: `npx create-db`

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

enum JobStatus {
  pending
  running
  done
  error
}

enum AcquisitionMethod {
  upload
  whisperx
  youtube
}

model User {
  id              String   @id @default(uuid())
  firebase_uid    String   @unique
  email           String   @unique
  display_name    String?
  native_language String
  is_admin        Boolean  @default(false)
  created_at      DateTime @default(now())

  media_content MediaContent[]
  decks         Deck[]
  cards         Card[]
  study_sessions StudySession[]
}

model MediaContent {
  id               String   @id @default(uuid())
  user_id          String
  title            String
  type             String
  source_language  String
  source_subtitle_acquisition_method  AcquisitionMethod?
  jellyfin_id      String?
  file_path        String?
  youtube_video_id String?
  job_status       JobStatus?
  job_progress     Int?     // 0-100
  job_logs         String?  // absolute path to log file on disk
  created_at       DateTime @default(now())

  user             User           @relation(fields: [user_id], references: [id])
  subtitle_tracks  SubtitleTrack[]
  subtitle_lines   SubtitleLine[]
}

model SubtitleTrack {
  id               String   @id @default(uuid())
  media_content_id String
  language         String
  is_source        Boolean
  created_at       DateTime @default(now())

  media_content  MediaContent   @relation(fields: [media_content_id], references: [id])
  subtitle_lines SubtitleLine[]

  @@unique([media_content_id, language])
}

model SubtitleLine {
  id                String @id @default(uuid())
  media_content_id  String
  subtitle_track_id String
  index             Int
  start_ms          Int
  end_ms            Int
  text              String

  media_content  MediaContent  @relation(fields: [media_content_id], references: [id])
  subtitle_track SubtitleTrack @relation(fields: [subtitle_track_id], references: [id])
}

model Deck {
  id         String   @id @default(uuid())
  user_id    String
  name       String
  is_default Boolean  @default(false)
  created_at DateTime @default(now())

  user  User   @relation(fields: [user_id], references: [id])
  cards Card[]
  study_sessions StudySession[]
}

model WordProfile {
  id              String   @id @default(uuid())
  word            String
  source_language String
  part_of_speech  String
  forms           Json
  lexical_family  String[]
  collocations    String[]
  generated_at    DateTime @default(now())

  cards Card[]

  @@unique([word, source_language])
}

model Card {
  id                      String   @id @default(uuid())
  user_id                 String
  deck_id                 String
  word                    String
  source_language         String
  translation_language    String
  word_translation        String
  context_text            String
  context_translation     String?
  media_content_id        String
  start_ms                Int
  end_ms                  Int
  contextual_definition   String?
  next_review             DateTime @default(now())
  interval_days           Int      @default(1)
  ease_factor             Float    @default(2.5)
  repetitions             Int      @default(0)
  word_profile_id         String?
  created_at              DateTime @default(now())

  user         User         @relation(fields: [user_id], references: [id])
  deck         Deck         @relation(fields: [deck_id], references: [id])
  word_profile WordProfile? @relation(fields: [word_profile_id], references: [id])
  study_session_cards StudySessionCard[]
}

model StudySession {
  id         String   @id @default(uuid())

  user_id    String
  deck_id    String
  source_language  String

  total_cards Int
  created_at DateTime @default(now())
  expires_at DateTime
  completed_at DateTime?

  reviewed_cards Int @default(0)

  user User @relation(fields: [user_id], references: [id], onDelete: Cascade)
  deck Deck @relation(fields: [deck_id], references: [id], onDelete: Cascade)

  cards StudySessionCard[]

  @@index([user_id])
  @@index([deck_id])
  @@index([created_at])
  @@index([expires_at])
}

model StudySessionCard {
  id String @id @default(uuid())

  session_id String
  card_id    String

  position Int

  reviewed Boolean @default(false)

  session StudySession @relation(fields: [session_id], references: [id], onDelete: Cascade)
  card    Card         @relation(fields: [card_id], references: [id], onDelete: Cascade)

  @@unique([session_id, position])
  @@unique([session_id, card_id])

  @@index([session_id, position])
  @@index([card_id])
}
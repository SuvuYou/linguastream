{
  "name": "@linguastream/db",
  "version": "0.0.0",
  "private": true,
  "description": "Prisma schema, migrations and client shared by the web app and the API (D-054, D-085).",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc --noEmit",
    "test:integration": "vitest run",
    "perf": "node perf/run.mjs",
    "postinstall": "prisma generate",
    "db:generate": "prisma generate",
    "db:migrate": "prisma migrate dev",
    "db:studio": "prisma studio",
    "db:import-dictionary": "tsc -p tsconfig.build.json && node scripts/import-dictionary.mjs"
  },
  "dependencies": {
    "@prisma/adapter-pg": "^7.6.0",
    "@prisma/client": "^7.6.0",
    "pg": "^8.20.0"
  },
  "devDependencies": {
    "@types/node": "^20",
    "@types/pg": "^8.20.0",
    "dotenv": "^17.4.0",
    "prisma": "^7.6.0",
    "typescript": "^5",
    "vitest": "^4.1.4"
  }
}

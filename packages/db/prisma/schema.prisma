// Target data model: docs/changes/006-data-model/spec.md (D-092–D-096).
// Models and fields in camelCase, tables and columns in snake_case (D-096).
// Indexes beyond keys are measured in docs/changes/007-indexes (D-097).

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

// ── Users and videos ────────────────────────────────────────────────

model User {
  id               String   @id @default(uuid(7)) @db.Uuid
  firebaseUid      String   @unique @map("firebase_uid")
  email            String   @unique
  displayName      String?  @map("display_name")
  nativeLanguage   String   @map("native_language")
  learningLanguage String   @map("learning_language")
  isAdmin          Boolean  @default(false) @map("is_admin")
  createdAt        DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  videos          Video[]
  vocabularyWords VocabularyWord[]
  decks           Deck[]

  @@map("users")
}

model Video {
  id             String   @id @default(uuid(7)) @db.Uuid
  userId         String   @map("user_id") @db.Uuid
  youtubeVideoId String   @map("youtube_video_id")
  title          String
  channelName    String?  @map("channel_name")
  durationMs     Int?     @map("duration_ms")
  language       String
  createdAt      DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  user        User               @relation(fields: [userId], references: [id], onDelete: Cascade)
  tracks      Track[]
  lemmaCounts VideoLemmaCount[]
  connections Connection[]

  @@unique([userId, youtubeVideoId])
  @@map("videos")
}

enum ProcessingStatus {
  pending
  processing
  ready
  failed

  @@map("processing_status")
}

model Track {
  id                String           @id @default(uuid(7)) @db.Uuid
  videoId           String           @map("video_id") @db.Uuid
  youtubeTrackId    String           @map("youtube_track_id")
  language          String
  isAutoCaptions    Boolean          @map("is_auto_captions")
  rawJson3          Bytes            @map("raw_json3")
  contentHash       String           @map("content_hash")
  processingVersion Int              @map("processing_version")
  status            ProcessingStatus @default(pending)
  progress          Int              @default(0)
  errorCode         String?          @map("error_code")
  normalisation     Json?
  createdAt         DateTime         @default(now()) @map("created_at") @db.Timestamptz(6)
  processedAt       DateTime?        @map("processed_at") @db.Timestamptz(6)

  video        Video              @relation(fields: [videoId], references: [id], onDelete: Cascade)
  lines        Line[]
  translations TrackTranslation[]

  @@unique([videoId, youtubeTrackId, contentHash, processingVersion])
  @@map("tracks")
}

model Line {
  id      String   @id @default(uuid(7)) @db.Uuid
  trackId String   @map("track_id") @db.Uuid
  index   Int
  startMs Int      @map("start_ms")
  endMs   Int      @map("end_ms")
  text    String
  rawText String   @map("raw_text")
  words   Json
  lemmas  String[] @default([])

  track        Track             @relation(fields: [trackId], references: [id], onDelete: Cascade)
  translations LineTranslation[]
  connections  Connection[]

  @@unique([trackId, index])
  @@index([lemmas], type: Gin)
  @@map("lines")
}

model TrackTranslation {
  id        String           @id @default(uuid(7)) @db.Uuid
  trackId   String           @map("track_id") @db.Uuid
  language  String
  status    ProcessingStatus @default(pending)
  progress  Int              @default(0)
  errorCode String?          @map("error_code")
  createdAt DateTime         @default(now()) @map("created_at") @db.Timestamptz(6)

  track Track             @relation(fields: [trackId], references: [id], onDelete: Cascade)
  lines LineTranslation[]

  @@unique([trackId, language])
  @@map("track_translations")
}

model LineTranslation {
  translationId String @map("translation_id") @db.Uuid
  lineId        String @map("line_id") @db.Uuid
  text          String

  translation TrackTranslation @relation(fields: [translationId], references: [id], onDelete: Cascade)
  line        Line             @relation(fields: [lineId], references: [id], onDelete: Cascade)

  @@id([translationId, lineId])
  @@index([lineId])
  @@map("line_translations")
}

model VideoLemmaCount {
  videoId String @map("video_id") @db.Uuid
  lemma   String
  count   Int

  video Video @relation(fields: [videoId], references: [id], onDelete: Cascade)

  @@id([videoId, lemma])
  @@map("video_lemma_counts")
}

// ── Compliance ──────────────────────────────────────────────────────

model BlockedVideo {
  youtubeVideoId String   @id @map("youtube_video_id")
  reason         String?
  createdAt      DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  @@map("blocked_videos")
}

// ── Vocabulary and review ───────────────────────────────────────────

enum WordStatus {
  unknown
  learning
  known
  ignored

  @@map("word_status")
}

enum StatusSource {
  manual
  placement
  save

  @@map("status_source")
}

model VocabularyWord {
  id             String       @id @default(uuid(7)) @db.Uuid
  userId         String       @map("user_id") @db.Uuid
  language       String
  lemma          String
  status         WordStatus
  statusSource   StatusSource @map("status_source")
  savedAt        DateTime?    @map("saved_at") @db.Timestamptz(6)
  ownTranslation String?      @map("own_translation")
  note           String?
  createdAt      DateTime     @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt      DateTime     @updatedAt @map("updated_at") @db.Timestamptz(6)

  user        User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  connections Connection[]
  card        Card?
  decks       DeckWord[]

  @@unique([userId, language, lemma])
  @@index([userId, savedAt(sort: Desc)])
  @@map("vocabulary_words")
}

model Connection {
  id             String   @id @default(uuid(7)) @db.Uuid
  wordId         String   @map("word_id") @db.Uuid
  videoId        String?  @map("video_id") @db.Uuid
  lineId         String?  @map("line_id") @db.Uuid
  youtubeVideoId String   @map("youtube_video_id")
  videoTitle     String   @map("video_title")
  startMs        Int      @map("start_ms")
  endMs          Int      @map("end_ms")
  sentence       String
  translation    String?
  pos            String?
  meaning        Json?
  grammar        Json     @default("{}")
  createdAt      DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  word  VocabularyWord @relation(fields: [wordId], references: [id], onDelete: Cascade)
  video Video?         @relation(fields: [videoId], references: [id], onDelete: SetNull)
  line  Line?          @relation(fields: [lineId], references: [id], onDelete: SetNull)

  @@index([wordId])
  @@index([videoId])
  @@index([lineId])
  @@map("connections")
}

model Deck {
  id          String   @id @default(uuid(7)) @db.Uuid
  userId      String   @map("user_id") @db.Uuid
  name        String
  description String?
  icon        String?
  color       String?
  createdAt   DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  user  User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  words DeckWord[]

  @@unique([userId, name])
  @@map("decks")
}

model DeckWord {
  deckId  String   @map("deck_id") @db.Uuid
  wordId  String   @map("word_id") @db.Uuid
  addedAt DateTime @default(now()) @map("added_at") @db.Timestamptz(6)

  deck Deck           @relation(fields: [deckId], references: [id], onDelete: Cascade)
  word VocabularyWord @relation(fields: [wordId], references: [id], onDelete: Cascade)

  @@id([deckId, wordId])
  @@index([wordId])
  @@map("deck_words")
}

enum CardState {
  new
  learning
  review
  relearning

  @@map("card_state")
}

model Card {
  id            String    @id @default(uuid(7)) @db.Uuid
  wordId        String    @unique @map("word_id") @db.Uuid
  due           DateTime  @default(now()) @db.Timestamptz(6)
  stability     Float     @default(0)
  difficulty    Float     @default(0)
  scheduledDays Int       @default(0) @map("scheduled_days")
  learningSteps Int       @default(0) @map("learning_steps")
  reps          Int       @default(0)
  lapses        Int       @default(0)
  state         CardState @default(new)
  lastReview    DateTime? @map("last_review") @db.Timestamptz(6)
  createdAt     DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)

  word       VocabularyWord @relation(fields: [wordId], references: [id], onDelete: Cascade)
  reviewLogs ReviewLog[]

  @@map("cards")
}

model ReviewLog {
  id          String   @id @default(uuid(7)) @db.Uuid
  cardId      String   @map("card_id") @db.Uuid
  rating      Int      @db.SmallInt
  stateBefore Json     @map("state_before")
  reviewedAt  DateTime @default(now()) @map("reviewed_at") @db.Timestamptz(6)
  durationMs  Int?     @map("duration_ms")

  card Card @relation(fields: [cardId], references: [id], onDelete: Cascade)

  @@index([cardId])
  @@map("review_logs")
}

// ── Dictionary (shared, imported in B3; spike 004) ──────────────────
// No relations to user data: words are lemma strings, and some lemmas
// are not in the dictionary (Q-40).

model DictionaryEntry {
  id         Int      @id @default(autoincrement())
  language   String
  word       String
  wordLower  String   @map("word_lower")
  pos        String
  gender     String?
  plural     String?
  flags      String[] @default([])
  senses     Json
  senseCount Int      @map("sense_count")

  @@index([language, word])
  @@index([language, wordLower])
  @@map("dictionary_entries")
}

model DictionaryForm {
  id        Int      @id @default(autoincrement())
  language  String
  form      String
  formLower String   @map("form_lower")
  lemma     String
  pos       String
  tags      String[] @default([])

  @@index([language, formLower])
  @@map("dictionary_forms")
}

model LemmaFrequency {
  language String
  word     String
  count    BigInt
  rank     Int

  @@id([language, word])
  @@map("lemma_frequencies")
}

// Shared caches filled by Gemini (D-060, D-065, Q-40). Dictionary data, not
// user content: kept across dictionary re-imports, keyed by text, not ids.

model GlossTranslation {
  language       String
  word           String
  pos            String
  gloss          String
  targetLanguage String   @map("target_language")
  text           String
  createdAt      DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  @@id([language, word, pos, gloss, targetLanguage])
  @@map("gloss_translations")
}

model AiWordEntry {
  language       String
  lemma          String
  targetLanguage String   @map("target_language")
  pos            String?
  gender         String?
  gloss          String?
  parts          String[] @default([])
  createdAt      DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  @@id([language, lemma, targetLanguage])
  @@map("ai_word_entries")
}

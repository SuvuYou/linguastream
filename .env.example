# Copy to .env (repo root) and fill in. Never commit .env.
# Shared by packages/db (Prisma CLI), apps/web (loaded in next.config.ts) and later apps/api.
# App-specific variables stay in the app's own env file (apps/web/.env.local).

# Local Postgres from compose.yaml (docker compose up -d)
DATABASE_URL=postgresql://linguastream_user:linguastream_pass@localhost:5432/linguastream_db

# Integration tests (pnpm test:integration). Same Postgres, separate database;
# the name must end in _test. The tests create it and reset it on every run.
TEST_DATABASE_URL=postgresql://linguastream_user:linguastream_pass@localhost:5432/linguastream_db_test

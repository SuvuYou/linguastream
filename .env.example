# Copy to .env (repo root) and fill in. Never commit .env.
# Shared by packages/db (Prisma CLI), apps/web (loaded in next.config.ts) and later apps/api.
# App-specific variables stay in the app's own env file (apps/web/.env.local).

# Local Postgres from compose.yaml (docker compose up -d)
DATABASE_URL=postgresql://linguastream:linguastream@localhost:5432/linguastream

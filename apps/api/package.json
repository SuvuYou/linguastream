    "@nestjs/core": "^12.6.0",
    "@nestjs/platform-express": "^12.6.0",
    "@nestjs/throttler": "^6.8.0",
    "cookie": "^2.0.2",
    "express": "^5.3.0",
    "firebase-admin": "^13.8.0",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.2",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@eslint/js": "^9",
    "@nestjs/cli": "^12.0.15",
    "@nestjs/schematics": "^12.0.0",
    "@nestjs/testing": "^12.6.0",
    "@swc/core": "^1.16.22",
    "@types/express": "^5.0.0",
    "@types/node": "^22",
    "@types/supertest": "^7.0.0",
    "@vitest/coverage-v8": "^4.1.4",
    "eslint": "^9",
    "supertest": "^7.0.0",

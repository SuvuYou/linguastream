{
  "name": "@linguastream/api",
  "version": "0.0.0",
  "private": true,
  "description": "NestJS API and worker (D-049, D-054).",
  "scripts": {
    "build": "nest build",
    "dev": "nest start --watch",
    "start": "node dist/main",
